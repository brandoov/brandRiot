{
  "openapi": "3.0.1",
  "info": {
    "title": "BrandRiot API",
    "description": "API .NET para integração com a Riot Games. Endpoints organizados por jogo: League of Legends, Teamfight Tactics, VALORANT (chave de produção) e Legends of Runeterra.",
    "version": "v1"
  },
  "paths": {
    "/api/account/by-riot-id": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Resolves a Riot ID (gameName#tagLine) to a puuid and persists the account.",
        "description": "Calls account-v1 by-riot-id and persists the account.",
        "parameters": [
          {
            "name": "gameName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tagLine",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/RiotCluster"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerSummaryResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerSummaryResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/by-puuid/{puuid}": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Fetches the Riot account by puuid and persists/refreshes it.",
        "parameters": [
          {
            "name": "puuid",
            "in": "path",
